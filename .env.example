# Copia este ficheiro para `.env` e preenche a chave.
# O `.env` está no .gitignore — nunca é commitado.

# Chave gratuita da API do Google Gemini, usada na leitura de faturas.
# Obtém uma em: https://aistudio.google.com/apikey
# Se deixares em branco, a app pede a chave ao utilizador na 1ª utilização.
VITE_GEMINI_KEY=
